<?xml version="1.0" encoding="utf-8"?>
<!-- Auto-backup rules for API 30 and below (android:fullBackupContent). allowBackup="false" is the
     primary control, but some Android 12+ devices still offer device-to-device transfer, so the
     private detection history (encrypted file + its temp file, plus the legacy plaintext name) is
     excluded explicitly as defence in depth. -->
<full-backup-content>
    <exclude domain="file" path="detection_events.enc" />
    <exclude domain="file" path="detection_events.enc.tmp" />
    <exclude domain="file" path="detection_events.json" />
</full-backup-content>
