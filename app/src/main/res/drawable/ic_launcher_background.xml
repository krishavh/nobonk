<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon BACKGROUND layer (T-REL-ASSETS). Full-bleed 108x108dp.
     Dark charcoal → deep-amber diagonal so the amber pedestrian reads as a
     "caution / look up" mark. Prefixed ic_launcher_* to avoid res/drawable
     collisions with the core agent's files. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt"
            name="android:fillColor">
            <gradient
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF1B1B1F" />
                <item android:offset="0.55" android:color="#FF241E12" />
                <item android:offset="1.0" android:color="#FF3A2A08" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
